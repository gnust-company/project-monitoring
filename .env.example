# ProjectHub — the SINGLE SOURCE OF CONFIGURATION. Copy to `.env` at the repo root, then edit the values.
#   - docker compose: every service receives this file via `env_file`; the ports here are read by compose too.
#   - backend outside docker: reads `<repo>/.env` directly; export a variable in the shell to override it.
#   - frontend `npm run dev`: Vite reads `VITE_API_BASE` from this file (only VITE_* vars reach the browser).
# Every variable below is REQUIRED unless marked "optional".

# ── Ports published on the host ───────────────────────────
# Change them if a port is already taken. When changing FRONTEND_PORT / BACKEND_PORT / MINIO_API_PORT,
# also update CORS_ORIGINS / VITE_API_BASE / MINIO_PUBLIC_URL below.
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Postgres ──────────────────────────────────────────────
# The postgres container creates the user/DB from these 3 vars; the backend reuses them to connect.
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=projecthub
POSTGRES_DB=projecthub
# host[:port] the BACKEND connects to:
#   - backend running in docker compose → "postgres" (service name, internal port 5432)
#   - backend running outside docker    → "localhost:<POSTGRES_PORT>"
#   - external DB                       → "192.168.1.10:5432"
POSTGRES_HOST=postgres
# (optional) full connection string; overrides the POSTGRES_* vars above when special parameters are needed.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# ── MinIO (object storage) ────────────────────────────────
# The minio container creates its root account from these 2 vars; the backend reuses them as access/secret key.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# URL the BACKEND uses to reach MinIO: in docker = "http://minio:9000"; outside docker = "http://localhost:<MINIO_API_PORT>".
MINIO_ENDPOINT=http://minio:9000
# URL the BROWSER uses to download files/avatars (real host/IP, not the docker service name).
MINIO_PUBLIC_URL=http://localhost:9000

# ── Backend ───────────────────────────────────────────────
# JWT signing key — set a long random string when deploying (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-prod
# Address the browser opens the frontend at (CSV for several); must match the real host:port.
CORS_ORIGINS=http://localhost:5173
# (optional) email domain allowlist for registration (#5): CSV, empty = no restriction.
# /auth/setup (first admin) is always allowed. E.g.: company.com,company.vn
ALLOWED_EMAIL_DOMAINS=

# ── Frontend ──────────────────────────────────────────────
# URL the browser uses to call the backend. Applied at RUNTIME (runtime-env.js) — switch it to the real
# IP/domain and run `docker compose up -d frontend`; NO image rebuild needed.
VITE_API_BASE=http://localhost:8000/api/v1
