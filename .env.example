# Copy thành .env trước khi `docker compose up`
# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=projecthub
POSTGRES_DB=projecthub

# ── MinIO (object storage) ────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# URL trình duyệt dùng để tải file/avatar (host, không phải tên service docker)
MINIO_PUBLIC_URL=http://localhost:9000

# ── Backend ───────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
CORS_ORIGINS=http://localhost:5173

# ── Frontend ──────────────────────────────────────────────
# URL trình duyệt dùng để gọi backend. Áp dụng lúc CHẠY (runtime-env.js) — đổi sang
# IP/domain thật rồi `docker compose up -d frontend` là xong, KHÔNG cần build lại image.
# Vd khi deploy: VITE_API_BASE=http://192.168.1.50:8000/api/v1
VITE_API_BASE=http://localhost:8000/api/v1
